    "\n",
    "# we are trying to predict pathology\n",
    "X_mass_train = mass_train[features]\n",
    "y_mass_train = mass_train[\"pathology\"]\n",
    "\n",
    "# assigning the same thing to the test dataset\n",
    "X_mass_test = mass_test[features]\n",
