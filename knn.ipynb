    "def run_KNN(train_file, test_file, neighbors=5, plot_cm=False, plot_cv=False):\n",
    "    train_data = pd.read_csv(f\"{train_file}\")\n",
    "    test_data = pd.read_csv(f\"{test_file}\")\n",
    "\n",
    "    features = ['breast density', 'left or right breast', 'image view',\n",
    "        'abnormality id', 'abnormality type', 'calc type', 'calc distribution',         #Technically abnormality type is same for all\n",
    "        'assessment', 'subtlety']\n",
    "    \n",
    "    #Features are different if calc or mass\n",
    "    if train_file.startswith(\"data/csv/calc\") and test_file.startswith(\"data/csv/calc\"):\n",
    "        features = ['breast density', 'left or right breast', 'image view',\n",
    "            'abnormality id', 'abnormality type', 'calc type', 'calc distribution',         #Technically abnormality type is same for all\n",
    "            'assessment', 'subtlety']\n",
    "        \n",
    "    elif train_file.startswith(\"data/csv/mass\") and test_file.startswith(\"data/csv/mass\"):\n",
    "        features = ['breast_density', 'left or right breast', 'image view',\n",
    "            'abnormality id', 'abnormality type', 'mass shape', 'mass margins',             #Technically abnormailty type is same for all\n",
    "            'assessment', 'subtlety']\n",
    "\n",
    "    else:\n",
    "        print(\"Files don't match\")\n",
    "        return\n",
    "\n",
    "    \n",
    "\n",
    "\n",
    "    #Getting training and test data columns\n",
    "    X_train = train_data[features]                   #Data Frame\n",
    "    y_train = train_data[\"pathology\"]                #Panda Series\n",
    "\n",
    "    X_test = test_data[features]\n",
    "    y_test = test_data['pathology']\n",
    "\n",
    "\n",
    "    #Preprocessing\n",
    "    #ENCODING\n",
    "    enc = OneHotEncoder(sparse_output=False, handle_unknown='ignore')\n",
    "\n",
    "    categorical_columns = X_train.select_dtypes(include=['object']).columns  #Index list\n",
    "    X_train_encoded_cat = enc.fit_transform(X_train[categorical_columns])\n",
    "    X_train_encoded_cat_df = pd.DataFrame(X_train_encoded_cat, columns=enc.get_feature_names_out(categorical_columns))\n",
    "\n",
    "    X_train_encoded = pd.concat([X_train.drop(columns=categorical_columns), \n",
    "                                X_train_encoded_cat_df],\n",
    "                                axis=1)\n",
    "\n",
    "\n",
    "    X_test_encoded_cat = enc.transform(X_test[categorical_columns])\n",
    "    X_test_encoded_cat_df = pd.DataFrame(X_test_encoded_cat, columns=enc.get_feature_names_out(categorical_columns))\n",
    "\n",
    "    X_test_encoded = pd.concat([X_test.drop(columns=categorical_columns),\n",
    "                               X_test_encoded_cat_df],\n",
    "                               axis=1)\n",
    "\n",
    "\n",
    "    #SCALING\n",
    "    scaler = StandardScaler()\n",
    "\n",
    "    X_train_scaled = scaler.fit_transform(X_train_encoded)\n",
    "    X_test_scaled = scaler.transform(X_test_encoded)\n",
    "\n",
    "\n",
    "    #Actually training and predicting\n",
    "    knn = KNeighborsClassifier(n_neighbors=neighbors, weights=\"distance\")\n",
    "    knn.fit(X_train_scaled, y_train)\n",
    "\n",
    "\n",
    "    y_pred = knn.predict(X_test_scaled)\n",
    "    print(f\"Test Accuracy (k={neighbors}): {accuracy_score(y_test, y_pred):.2f}\")\n",
    "\n",
    "\n",
    "\n",
    "    if plot_cm == True:\n",
    "        cm = confusion_matrix(y_test, y_pred)\n",
    "        disp = ConfusionMatrixDisplay(confusion_matrix=cm, display_labels=[\"Benign\", \"Malignant\"])\n",
    "        disp.plot(cmap=\"Blues\")\n",
    "        plt.title(f\"Confusion Matrix (k=5)\")\n",
    "        plt.grid(False)\n",
    "        plt.show()\n",
    "\n",
    "        # Detailed classification report\n",
    "        print(\"Classification Report:\")\n",
    "        print(classification_report(y_test, y_pred, target_names=[\"Benign\", \"Malignant\"]))\n",
    "\n",
    "    if plot_cv == True:\n",
    "        k_range = range(1,21)\n",
    "        cv_scores = []\n",
    "        for k in k_range:\n",
    "            knn = KNeighborsClassifier(n_neighbors=neighbors, weights=\"distance\")\n",
    "            # skf = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)\n",
    "            scores = cross_val_score(knn, X_train_scaled, y_train, cv=5, scoring='accuracy')\n",
    "            cv_scores.append(scores.mean())\n",
    "\n",
    "        plt.figure(figsize=(8,5))\n",
    "        plt.plot(k_range, cv_scores, marker='o')\n",
    "        plt.title(\"k-NN Cross-Validation Accuracy vs k\")\n",
    "        plt.xlabel(\"k Nearest Neighbors\")\n",
    "        plt.ylabel(\"Cross Validation Accuracy\")\n",
