   "source": [
    "Preprocessing (Converting categorical to encoded integers)   & Scaling\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 15,
   "id": "96791927",
   "metadata": {},
   "outputs": [],
   "source": [
    "#ENCODING\n",
    "enc = OneHotEncoder(sparse_output=False, handle_unknown='ignore')\n",
    "\n",
    "# X_encoded = enc.fit_transform(X)\n",
    "\n",
    "encoded_categories = enc.fit_transform(X_train[categorical_columns])\n",
