    "    elif train_file.startswith(\"data/csv/mass\") and test_file.startswith(\"data/csv/mass\"):\n",
    "        features = ['breast_density', 'left or right breast', 'image view',\n",
    "            'abnormality id', 'abnormality type', 'mass shape', 'mass margins',             #Technically abnormailty type is same for all\n",
    "            'assessment', 'subtlety']\n",
    "\n",
    "    else:\n",
    "        print(\"Files don't match\")\n",
    "        return\n",
    "\n",
    "\n",
    "\n",
    "    #Getting training and test data columns\n",
    "    X_train = train_data[features]                   #Data Frame\n",
    "    y_train = train_data[\"pathology\"]                #Panda Series\n",
    "\n",
    "    X_test = test_data[features]\n",
    "    y_test = test_data['pathology']\n",
    "\n",
    "\n",
    "    #Preprocessing\n",
    "    #ENCODING\n",
    "    enc = OneHotEncoder(sparse_output=False, handle_unknown='ignore')\n",
    "\n",
    "    categorical_columns = X_train.select_dtypes(include=['object']).columns  #Index list\n",
    "    X_train_encoded_cat = enc.fit_transform(X_train[categorical_columns])\n",
    "    X_train_encoded_cat_df = pd.DataFrame(X_train_encoded_cat, columns=enc.get_feature_names_out(categorical_columns), index=X_train.index)\n",
    "\n",
    "    X_train_encoded = pd.concat([X_train.drop(columns=categorical_columns), \n",
    "                                X_train_encoded_cat_df],\n",
    "                                axis=1)\n",
    "\n",
    "\n",
    "    X_test_encoded_cat = enc.transform(X_test[categorical_columns])\n",
    "    X_test_encoded_cat_df = pd.DataFrame(X_test_encoded_cat, columns=enc.get_feature_names_out(categorical_columns), index=X_test.index)  \n",
    "\n",
    "    X_test_encoded = pd.concat([X_test.drop(columns=categorical_columns),\n",
    "                               X_test_encoded_cat_df],\n",
    "                               axis=1)\n",
    "\n",
    "\n",
    "    #SCALING\n",
    "    scaler = StandardScaler()\n",
    "\n",
    "    X_train_scaled = scaler.fit_transform(X_train_encoded)\n",
    "    X_test_scaled = scaler.transform(X_test_encoded)\n",
    "\n",
    "\n",
    "    #Actually training and predicting\n",
    "    knn = KNeighborsClassifier(n_neighbors=neighbors, weights=\"distance\")\n",
    "    knn.fit(X_train_scaled, y_train)\n",
    "\n",
    "\n",
    "    y_pred = knn.predict(X_test_scaled)\n",
    "    print(f\"Test Accuracy (k={neighbors}): {accuracy_score(y_test, y_pred):.2f}\")\n",
    "\n",
    "    sfs = SequentialFeatureSelector(\n",
    "        estimator=knn,\n",
    "        n_features_to_select=4,\n",
    "        direction='backward',\n",
    "        cv=2\n",
    "    )\n",
    "\n",
    "    sfs.fit(X_train_scaled, y_train)\n",
    "\n",
    "    feature_names = X_train_encoded.columns\n",
    "    selected_features = feature_names[sfs.get_support()]\n",
    "\n",
    "    print(\"Features selected by SFS:\")\n",
    "    print(selected_features.tolist())\n",
    "        \n",
    "\n"
   ]
  },
