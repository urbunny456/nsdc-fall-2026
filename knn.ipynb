   "id": "e592d409",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Index(['patient_id', 'breast density', 'left or right breast', 'image view',\n",
      "       'abnormality id', 'abnormality type', 'calc type', 'calc distribution',\n",
      "       'assessment', 'pathology', 'subtlety', 'image file path',\n",
      "       'cropped image file path', 'ROI mask file path'],\n",
      "      dtype='object')\n",
      "['MALIGNANT' 'BENIGN' 'BENIGN_WITHOUT_CALLBACK']\n"
     ]
    }
   ],
   "source": [
    "# list all columns\n",
    "print(case_train.columns)\n",
    "\n",
    "# print unique values of pathology \n",
    "print(case_train['pathology'].unique())"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "id": "cff4e5c1",
   "metadata": {},
   "outputs": [],
   "source": [
    "# choose features for your model\n",
    "features = ['breast density', 'left or right breast', 'image view',\n",
    "       'abnormality id', 'abnormality type', 'calc type', 'calc distribution',\n",
    "       'assessment', 'subtlety']\n",
    "X_train = case_train[features]\n",
    "\n",
    "# we are trying to predict pathology\n",
    "y_train = case_train[\"pathology\"]\n",
    "\n",
    "# assigning the same things to the test dataset\n",
    "X_test = case_test[features]\n",
    "y_test = case_test['pathology']"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 10,
   "id": "a6389f69",
   "metadata": {},
   "outputs": [],
   "source": [
    "# combine datasets\n",
    "X = pd.concat([X_train, X_test], ignore_index=True)\n",
    "y = pd.concat([y_train, y_test], ignore_index=True)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "3eb772d0",
   "metadata": {},
   "outputs": [],
   "source": [
    "# normalize features, meaning adjust numeric values of diff data into a similar scale. necessary so each thing can be weighed similarly\n",
    "scaler = StandardScaler()\n",
    "\n",
    "# NOTE!! THIS WILL ERROR BECAUSE WE HAVE CATEGORICAL DATA\n",
    "# we need to convert all categorical data into numeric values\n",
    "# if we convert to numeric values, then we have an inherent \"ordering\" of the values\n",
    "# therefore, we need to use a distance metric that accounts for categorical values\n",
    "X_scaled = scaler.fit_transform(X)\n",
    "X_train_scaled = scaler.fit_transform(X_train)\n",
    "X_test_scaled = scaler.transform(X_test)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "cad8156c",
   "metadata": {},
   "source": [
    "Note! Since our dataset already splits it into training and testing, we don't need to do that on our own. This is important to be aware of, because there is a function in sklearn that can split our data into training and testing and you'll often see code online use that"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "9f74bbb0",
   "metadata": {},
   "source": [
    "Documentation: https://scikit-learn.org/stable/modules/generated/sklearn.neighbors.KNeighborsClassifier.html"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "875a5930",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Train a k-NN classifier\n",
    "knn = KNeighborsClassifier(n_neighbors=5)\n",
    "knn.fit(X_train, y_train)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "3de900a1",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Predict and evaluate\n",
    "y_pred = knn.predict(X_test)\n",
    "print(f\"Test Accuracy (k=5): {accuracy_score(y_test, y_pred):.2f}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "50fbcffd",
   "metadata": {},
   "source": [
    "To see how well this does, let's run cross-validation. "
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "52e8ef3d",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 800x500 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Best k from cross-validation: 5\n"
     ]
    }
   ],
   "source": [
    "# for cross validation, we use the training data\n",
    "\n",
    "# Range of k values to try\n",
    "k_range = range(1, 21)\n",
    "cv_scores = []\n",
    "\n",
    "# Evaluate each k using 5-fold cross-validation\n",
    "for k in k_range:\n",
    "    knn = KNeighborsClassifier(n_neighbors=k)\n",
    "    scores = cross_val_score(knn, X_train_scaled, y_train, cv=5, scoring='accuracy')\n",
    "    cv_scores.append(scores.mean())\n",
    "\n",
    "# Plot accuracy vs. k\n",
    "plt.figure(figsize=(8, 5))\n",
    "plt.plot(k_range, cv_scores, marker='o')\n",
    "plt.title(\"k-NN Cross-Validation Accuracy vs k\")\n",
    "plt.xlabel(\"Number of Neighbors: k\")\n",
    "plt.ylabel(\"Cross-Validated Accuracy\")\n",
    "plt.grid(True)\n",
    "plt.show()\n",
    "\n",
    "# Best k\n",
    "best_k = k_range[np.argmax(cv_scores)]\n",
    "print(f\"Best k from cross-validation: {best_k}\")"
   ]
  },
